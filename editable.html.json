/\n}\n.silex-editor .hamburger-menu_1736777684796_433 nav {\n  left: -9999px;\n}\n.hamburger-menu_1736777684796_433 nav ul {\n  margin-top: 80px;\n}\n.hamburger-menu_1736777684796_433 nav {\n  opacity: 0; /* avoid flicker at start */\n  position: absolute;\n  background-color: #ededed;\n  transition: left 1s ease, height 0s ease 1s;\n  left: -300px;\n  width: 300px;\n  height: 20px\n}\n.hamburger-menu_1736777684796_433.open nav {\n  opacity: 1;\n  height: 100vh;\n  left: 0;\n  transition: left 1s ease, height 0s ease 0s;\n}\n\n.hamburger-menu_1736777684796_433 .nav-container {\n  z-index: 10;\n  position: absolute;\n}\n.hamburger-menu_1736777684796_433.open .nav-container {\n}\n\n/* hamburger button */\n.hamburger-menu_1736777684796_433 .hamburger-btn {\n    z-index: 20;\n    cursor: pointer;\n    position: absolute;\n}\n.hamburger-menu_1736777684796_433 .hamburger-btn span {\n    display: block;\n    width: 30px;\n    height: 5px;\n    margin-bottom: 3px;\n    position: relative;\n    background-color: #000000;\n    border: 1px solid #ffffff;\n    border-radius: 3px;\n    transition: border-color 0.1s ease-in,\n      opacity 0.1s ease-in,\n      transform 0.1s ease-in,\n      background 0.1s ease-in\n}\n\n.hamburger-menu_1736777684796_433.open .hamburger-btn span {\n    border-color: rgba(255, 255, 255, 0);\n}\n\n.hamburger-menu_1736777684796_433 .hamburger-btn span:first-child {\n    transform-origin: 4px -2px;\n}\n.hamburger-menu_1736777684796_433.open .hamburger-btn span:first-child {\n    transform: rotate(45deg) translate(7px, -4px);\n}\n\n.hamburger-menu_1736777684796_433.open .hamburger-btn span:nth-last-child(2) {\n    opacity: 0;\n}\n\n.hamburger-menu_1736777684796_433 .hamburger-btn span:nth-child(3) {\n    transform-origin: -11px 4px;\n}\n.hamburger-menu_1736777684796_433.open .hamburger-btn span:nth-child(3) {\n    transform: rotate(-45deg) translate(0, 12px);\n}\n\n/* themes */\n\n\n</style>\n<!-- inspired by https://codepen.io/erikterwan/pen/EVzeRP --